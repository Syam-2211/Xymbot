# ==========================================
# 🤖 XYMBOT ENVIRONMENT CONFIGURATION (.env.example)
# ==========================================

# ── 1. SESSION & DATABASE (REQUIRED) ──
# Option A: Custom session name saved in MongoDB (e.g. sneha-bot)
# Option B: Or paste raw session string (starts with XYMBOT~)
SESSION_ID=

# MongoDB URI (REQUIRED if you use a custom session name from the pairing site)
MONGO_URI=

# ── 2. SERVER PORT (REQUIRED FOR CLOUD / RENDER) ──
# Render sets PORT automatically, but default is 8000
PORT=8000
NODE_VERSION=20.14.0

# ── 3. BOT BASIC SETTINGS ──
# Prefix for commands (e.g. . or ! or #)
PREFIX=.

# Bot display name
BOT_NAME=🕊🦋⃝♥⃝ѕиєнα🍁♥⃝🦋⃝🕊

# Owner display name
OWNER_NAME=🤍⃞𝄟ꪶ𝐒͢ʏ᪳ᴀ͓ᴍ͎ ͢𝐒ᴇ͓ꪳʀ͎𖦻⃞🍓

# Owner WhatsApp number(s) with country code (separate multiple with comma)
OWNER_NUMBER=919947121619,918075495063

# Mode: 'public' (everyone can use) or 'private' (owner/sudo only)
WORK_TYPE=public

# ── 4. AI & EXTERNAL API KEYS (OPTIONAL) ──
# Google Gemini API key for .gemini and .ai commands (Get free from https://aistudio.google.com)
GEMINI_API_KEY=

# OpenAI API key for ChatGPT commands (Optional)
OPENAI_API_KEY=

# Remove.bg API key for background removal commands (Get free from https://www.remove.bg/api)
REMOVEBG_KEY=

# License key if applicable
LICENSE_KEY=
