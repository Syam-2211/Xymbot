const { cmd } = require('../command');
const { fetchJson } = require('../lib/functions');

cmd({
    on: "text",
    desc: "Auto-download media links",
    category: "download",
    filename: __filename
},
async (conn, mek, m, { from, body, reply }) => {
    try {
        if (!body) return;
        // Ignore messages that are actually commands (e.g. .tiktok) to avoid double downloading
        if (body.startsWith(global.prefix)) return;

        // --- TIKTOK AUTO-DL ---
        const tiktokRegex = /(https?:\/\/(?:www\.|vm\.|vt\.)?tiktok\.com\/[^\s]+)/i;
        const ttMatch = body.match(tiktokRegex);
        if (ttMatch) {
            let q = ttMatch[1];
            reply("⬇️ *Auto-Downloading TikTok...*");
            
            let data = await fetchJson(`https://www.tikwm.com/api/?url=${q}`);
            if (!data.data) return reply("❌ Error: Video not found. Is the profile private?");

            let caption = `
╭━━━〔 ✧ *AUTO DOWNLOADER* ✧ 〕━━━┈
┃ 🎵 *Platform:* TikTok
┃ 👤 *Author:* ${data.data.author.nickname}
┃ 📝 *Title:* ${data.data.title}
┃ 👑 *Owner:* 🤍⃞𝄟ꪶ𝐒͢ʏ᪳ᴀ͓ᴍ͎ ͢𝐒ᴇ͓ꪳʀ͎𖦻⃞🍓
╰━━━━━━━━━━━━━━━━━━━━━━━━┈
`.trim();
            await conn.sendMessage(from, { video: { url: data.data.play }, caption: caption }, { quoted: mek });
            await conn.sendMessage(from, { audio: { url: data.data.music }, mimetype: "audio/mpeg" }, { quoted: mek });
            return;
        }

        // --- INSTAGRAM AUTO-DL ---
        const instaRegex = /(https?:\/\/(?:www\.)?instagram\.com\/(?:p|reel|tv)\/[^\s]+)/i;
        const igMatch = body.match(instaRegex);
        if (igMatch) {
            let q = igMatch[1];
            reply("⬇️ *Auto-Downloading Instagram...*");

            let caption = `
╭━━━〔 ✧ *AUTO DOWNLOADER* ✧ 〕━━━┈
┃ 📸 *Platform:* Instagram
┃ 👑 *Owner:* 🤍⃞𝄟ꪶ𝐒͢ʏ᪳ᴀ͓ᴍ͎ ͢𝐒ᴇ͓ꪳʀ͎𖦻⃞🍓
╰━━━━━━━━━━━━━━━━━━━━━━━━┈
`.trim();
            let mediaUrl = "";
            try {
                let data = await fetchJson(`https://api.siputzx.my.id/api/d/igram?url=${q}`);
                if (data && data.data && data.data.success !== false && data.data.status !== false) {
                    if (Array.isArray(data.data.response)) {
                        mediaUrl = data.data.response[0]?.url || data.data.response[0];
                    } else {
                        mediaUrl = data.data.response?.url || data.data.response;
                    }
                }
            } catch (err) {}

            if (!mediaUrl) {
                try {
                    let fallbackData = await fetchJson(`https://api.ryzendesu.vip/api/downloader/igdl?url=${q}`);
                    if (fallbackData && fallbackData.data && fallbackData.data[0]) {
                        mediaUrl = fallbackData.data[0].url;
                    }
                } catch (err) {}
            }

            if (mediaUrl) {
                await conn.sendMessage(from, { video: { url: mediaUrl }, caption: caption }, { quoted: mek });
            } else {
                reply("❌ Error: Instagram Auto-DL failed.");
            }
            return;
        }

        // --- FACEBOOK AUTO-DL ---
        const fbRegex = /(https?:\/\/(?:www\.|web\.|m\.)?facebook\.com\/[^\s]+|https?:\/\/fb\.watch\/[^\s]+)/i;
        const fbMatch = body.match(fbRegex);
        if (fbMatch) {
            let q = fbMatch[1];
            reply("⬇️ *Auto-Downloading Facebook...*");

            let data = await fetchJson(`https://api.siputzx.my.id/api/d/facebook?url=${q}`);
            if (!data.data || !data.data.downloads || data.data.downloads.length === 0) return reply("❌ Error: Video not found or private.");

            let caption = `
╭━━━〔 ✧ *AUTO DOWNLOADER* ✧ 〕━━━┈
┃ 📘 *Platform:* Facebook
┃ 👑 *Owner:* 🤍⃞𝄟ꪶ𝐒͢ʏ᪳ᴀ͓ᴍ͎ ͢𝐒ᴇ͓ꪳʀ͎𖦻⃞🍓
╰━━━━━━━━━━━━━━━━━━━━━━━━┈
`.trim();
            const downloads = data.data.downloads;
            let videoUrl = downloads.find(u => u.quality.includes('HD'))?.url 
                || downloads.find(u => u.quality.includes('SD'))?.url 
                || downloads[0].url;

            await conn.sendMessage(from, { video: { url: videoUrl }, caption: caption }, { quoted: mek });
            return;
        }

    } catch (e) {
        console.error("Auto-DL Error:", e);
    }
});
